<?xml version="1.0"?>
<robot name="agrobot">
  <!-- base_link: геометрический центр, X вперёд, Y влево, Z вверх -->
  <link name="base_link"/>
  <!-- Модель прототипа 2025/agrobot forward -->
  <link name="front_hit"/>
  <joint name="front_hit_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_hit"/>
    <origin xyz="0.601704532 0.000000000 0.273101239" rpy="0.000000000 0.000000000 0.000000000"/>
  </joint>
  <!-- Модель прототипа 2025/upper right -->
  <link name="wheel_fr"/>
  <joint name="wheel_fr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
    <origin xyz="0.317800254 -0.316000000 0.103505609" rpy="0.000000000 0.000000000 0.000000000"/>
  </joint>
  <!-- Модель прототипа 2025/upper left -->
  <link name="wheel_fl"/>
  <joint name="wheel_fl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.317800254 0.316000000 0.103505609" rpy="0.000000000 0.000000000 0.000000000"/>
  </joint>
  <!-- Модель прототипа 2025/bottom right -->
  <link name="wheel_rr"/>
  <joint name="wheel_rr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.317800254 -0.316000000 0.103505609" rpy="0.000000000 0.000000000 0.000000000"/>
  </joint>
  <!-- Модель прототипа 2025/bottom left -->
  <link name="wheel_rl"/>
  <joint name="wheel_rl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.317800254 0.316000000 0.103505609" rpy="0.000000000 0.000000000 0.000000000"/>
  </joint>
  <!-- 405:1+RealSense_D405:1/D405 left -->
  <link name="d405_link"/>
  <joint name="d405_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="d405_link"/>
    <origin xyz="0.533606281 0.009550556 0.203636340" rpy="0.007227583 0.261792858 0.001870621"/>
  </joint>
  <link name="d405_link_optical"/>
  <joint name="d405_link_optical_joint" type="fixed">
    <parent link="d405_link"/>
    <child link="d405_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0.000000000 -1.570796327"/>
  </joint>
  <!-- Intel_RealSense_Depth_Camera_D435:1/User Coordinate System1 -->
  <link name="d435_link"/>
  <joint name="d435_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="d435_link"/>
    <origin xyz="0.451636729 -0.017499974 0.691293991" rpy="0.000000000 0.872664626 0.000000000"/>
  </joint>
  <link name="d435_link_optical"/>
  <joint name="d435_link_optical_joint" type="fixed">
    <parent link="d435_link"/>
    <child link="d435_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0.000000000 -1.570796327"/>
  </joint>
</robot>
