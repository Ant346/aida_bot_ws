<?xml version="1.0"?>
<robot name="agrobot">
  <!-- base_link: геометрический центр, X вперёд, Y влево, Z вверх -->
  <link name="base_link"/>
  <!-- Модель прототипа 2025/agrobot forward -->
  <link name="front_hit"/>
  <joint name="front_hit_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_hit"/>
    <origin xyz="0.601704532 0.000000000 0.273101239" rpy="0.000000000 0.000000000 0.000000000"/>
  </joint>
  <!-- 405:1+RealSense_D405:1/User Coordinate System1 -->
  <link name="d405_link"/>
  <joint name="d405_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="d405_link"/>
    <origin xyz="0.533606281 0.009550556 0.203636340" rpy="0.007227583 0.261792858 0.001870621"/>
  </joint>
  <link name="d405_link_optical"/>
  <joint name="d405_link_optical_joint" type="fixed">
    <parent link="d405_link"/>
    <child link="d405_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0.000000000 -1.570796327"/>
  </joint>
  <!-- zedm_universal_box_forward:1+ZEDM:2/ZEDm center -->
  <link name="zedm_center"/>
  <joint name="zedm_center_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zedm_center"/>
    <origin xyz="0.430335978 -0.008458000 0.718982834" rpy="0.000000000 0.349065850 0.000000000"/>
  </joint>
  <link name="zedm_center_optical"/>
  <joint name="zedm_center_optical_joint" type="fixed">
    <parent link="zedm_center"/>
    <child link="zedm_center_optical"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0.000000000 -1.570796327"/>
  </joint>
  <!-- zedm_universal_box_forward:1+ZEDM:2/ZEDm right -->
  <link name="zedm_right"/>
  <joint name="zedm_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zedm_right"/>
    <origin xyz="0.430335978 -0.039958000 0.718982834" rpy="0.000000000 0.349065850 0.000000000"/>
  </joint>
  <link name="zedm_right_optical"/>
  <joint name="zedm_right_optical_joint" type="fixed">
    <parent link="zedm_right"/>
    <child link="zedm_right_optical"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0.000000000 -1.570796327"/>
  </joint>
  <!-- zedm_universal_box_forward:1+ZEDM:2/ZEDm left -->
  <link name="zedm_left"/>
  <joint name="zedm_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zedm_left"/>
    <origin xyz="0.430335978 0.023042001 0.718982834" rpy="0.000000000 0.349065850 0.000000000"/>
  </joint>
  <link name="zedm_left_optical"/>
  <joint name="zedm_left_optical_joint" type="fixed">
    <parent link="zedm_left"/>
    <child link="zedm_left_optical"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0.000000000 -1.570796327"/>
  </joint>
</robot>
