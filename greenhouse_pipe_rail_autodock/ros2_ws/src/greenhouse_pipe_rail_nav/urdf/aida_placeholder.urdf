<?xml version="1.0"?>
<!-- Placeholder robot model for RViz. Replace with the real URDF/xacro later. -->
<robot name="aida_placeholder">
  <material name="body_gray">
    <color rgba="0.45 0.45 0.48 1"/>
  </material>
  <material name="camera_black">
    <color rgba="0.12 0.12 0.14 1"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.50 0.20"/>
      </geometry>
      <material name="body_gray"/>
    </visual>
  </link>

  <!-- Approximate camera pose; refine when the real model lands. -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.20 0 0.18" rpy="0 0.35 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
      <material name="camera_black"/>
    </visual>
  </link>
</robot>
